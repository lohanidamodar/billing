{
    "name": "utopia-php/billing",
    "description": "Billing library for subscription management, invoicing, coupons, discounts, wallets, and transactions",
    "type": "library",
    "keywords": [
        "php",
        "framework",
        "upf",
        "utopia",
        "billing",
        "subscription",
        "invoicing"
    ],
    "license": "MIT",
    "minimum-stability": "stable",
    "scripts": {
        "lint": "./vendor/bin/pint --test",
        "format": "./vendor/bin/pint",
        "test": "vendor/bin/phpunit --configuration phpunit.xml",
        "check": "./vendor/bin/phpstan analyse --level max src tests"
    },
    "autoload": {
        "psr-4": {
            "Utopia\\Billing\\": "src/Billing"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Utopia\\Tests\\": "tests"
        }
    },
    "require": {
        "php": ">=8.1",
        "utopia-php/database": "4.*",
        "utopia-php/pay": "0.*"
    },
    "require-dev": {
        "phpunit/phpunit": "9.*",
        "phpstan/phpstan": "1.*",
        "laravel/pint": "1.*"
    },
    "suggest": {
        "mpdf/mpdf": "Required for PDF invoice rendering"
    }
}
