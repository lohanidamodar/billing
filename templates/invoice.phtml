    /* Print */
    @media print {
        body {
            background: #ffffff;
        }

        .invoice {
            margin: 0;
            border: none;
            border-radius: 0;
            box-shadow: none;
        }

        .invoice-header {
            background: #fafafa;
        }

        .invoice-footer {
            background: #fafafa;
        }
    }

    /* Responsive */
    @media (max-width: 640px) {
        .invoice-header {
            flex-direction: column;
            gap: 16px;
            padding: 24px 20px;
        }

        .invoice-parties {
            flex-direction: column;
            gap: 20px;
            padding: 20px 20px;
        }

        .invoice-party:last-child {
            text-align: left;
        }

        .invoice-meta {
            flex-wrap: wrap;
            gap: 16px;
            padding: 0 20px 20px;
        }

        .invoice-items {
            padding: 0 20px;
            overflow-x: auto;
        }

        .invoice-totals {
            padding: 20px 20px 24px;
        }

        .totals-table {
