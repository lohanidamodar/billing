<?php

/**
 * Default Invoice Template
 *
 * Variables available:
 * @var \Utopia\Billing\Invoice $invoice  The invoice object
 * @var array<int, array<string, mixed>> $items  Line items from the invoice
 * @var array<string, mixed> $entity  Customer/entity info (name, address, email, etc.)
 * @var array<string, mixed> $issuer  Issuer/company info (name, address, taxId, etc.)
 */

$currency = $invoice->getCurrency() ?: 'USD';

/**
 * Format a monetary amount to 2 decimal places.
 */
$formatAmount = function (float $amount) use ($currency): string {
    $symbol = match (\strtoupper($currency)) {
        'USD' => '$',
        'EUR' => "\xe2\x82\xac",
        'GBP' => "\xc2\xa3",
        'JPY' => "\xc2\xa5",
        'CAD' => 'CA$',
        'AUD' => 'A$',
        'CHF' => 'CHF ',
        'CNY' => "\xc2\xa5",
        'INR' => "\xe2\x82\xb9",
        'BRL' => 'R$',
        default => \strtoupper($currency) . ' ',
    };

    return $symbol . \number_format(\abs($amount), 2);
};

/**
 * Format a date string for display.
 */
$formatDate = function (?string $date): string {
    if ($date === null || $date === '') {
        return "\xe2\x80\x94";
    }

    try {
        return (new \DateTime($date))->format('M j, Y');
    } catch (\Throwable $e) {
        return $date;
    }
};

/**
 * Escape HTML entities.
 */
$e = function (?string $value): string {
    return \htmlspecialchars($value ?? '', \ENT_QUOTES | \ENT_HTML5, 'UTF-8');
};

$statusLabel = \strtoupper($invoice->getStatus());
$statusColor = match ($invoice->getStatus()) {
    'paid' => '#16a34a',
    'draft' => '#6b7280',
    'finalized' => '#2563eb',
    'failed' => '#dc2626',
    'voided' => '#9333ea',
    default => '#6b7280',
};

$isCreditNote = $invoice->isCreditNote();

?>
<!DOCTYPE html>
