        color: #111827;
    }

    .totals-table .total-row-grand .total-value {
        font-size: 18px;
        font-weight: 700;
        color: #111827;
    }

    .totals-divider {
        border: none;
        border-top: 1px solid #e5e7eb;
        margin: 12px 0;
    }

    .totals-table .total-payment .total-label {
        font-size: 13px;
        color: #9ca3af;
    }

    .totals-table .total-payment .total-value {
        font-size: 13px;
        color: #6b7280;
        font-weight: 400;
    }

    /* Footer */
    .invoice-footer {
        padding: 20px 40px;
        border-top: 1px solid #e5e7eb;
        background: #fafafa;
        text-align: center;
        font-size: 12px;
        color: #9ca3af;
