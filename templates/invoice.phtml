</head>
<body>

<div class="invoice">
    <!-- Header -->
    <div class="invoice-header">
        <div>
            <div class="invoice-title"><?= $e($isCreditNote ? 'Credit Note' : 'Invoice') ?></div>
            <?php if ($invoice->getNumber() !== ''): ?>
                <div class="invoice-number">#<?= $e($invoice->getNumber()) ?></div>
            <?php endif; ?>
        </div>
        <div>
            <span class="invoice-status" style="background-color: <?= $e($statusColor) ?>;">
                <?= $e($statusLabel) ?>
            </span>
        </div>
    </div>

    <!-- Parties: Issuer & Entity -->
    <?php if (!empty($issuer) || !empty($entity)): ?>
    <div class="invoice-parties">
        <div class="invoice-party">
            <div class="party-label">From</div>
            <?php if (!empty($issuer['name'])): ?>
                <div class="party-name"><?= $e($issuer['name']) ?></div>
            <?php endif; ?>
            <div class="party-detail">
                <?php if (!empty($issuer['address'])): ?>
                    <?= \nl2br($e($issuer['address'])) ?><br>
                <?php endif; ?>
                <?php if (!empty($issuer['email'])): ?>
                    <?= $e($issuer['email']) ?><br>
                <?php endif; ?>
                <?php if (!empty($issuer['phone'])): ?>
                    <?= $e($issuer['phone']) ?><br>
                <?php endif; ?>
                <?php if (!empty($issuer['taxId'])): ?>
                    Tax ID: <?= $e($issuer['taxId']) ?>
                <?php endif; ?>
            </div>
        </div>
        <div class="invoice-party">
            <div class="party-label">Bill To</div>
            <?php if (!empty($entity['name'])): ?>
                <div class="party-name"><?= $e($entity['name']) ?></div>
            <?php endif; ?>
            <div class="party-detail">
                <?php if (!empty($entity['address'])): ?>
                    <?= \nl2br($e($entity['address'])) ?><br>
                <?php endif; ?>
                <?php if (!empty($entity['email'])): ?>
                    <?= $e($entity['email']) ?><br>
                <?php endif; ?>
                <?php if (!empty($entity['phone'])): ?>
                    <?= $e($entity['phone']) ?><br>
                <?php endif; ?>
                <?php if (!empty($entity['taxId'])): ?>
                    Tax ID: <?= $e($entity['taxId']) ?>
                <?php endif; ?>
            </div>
        </div>
    </div>
    <?php endif; ?>

    <!-- Meta: Dates & Currency -->
    <div class="invoice-meta">
        <?php if ($invoice->getDueDate() !== null): ?>
        <div class="meta-item">
            <span class="meta-label">Due Date</span>
            <span class="meta-value"><?= $e($formatDate($invoice->getDueDate())) ?></span>
        </div>
        <?php endif; ?>
        <?php if ($invoice->getPaidAt() !== null): ?>
        <div class="meta-item">
            <span class="meta-label">Paid On</span>
            <span class="meta-value"><?= $e($formatDate($invoice->getPaidAt())) ?></span>
        </div>
        <?php endif; ?>
        <?php if ($currency !== ''): ?>
        <div class="meta-item">
            <span class="meta-label">Currency</span>
            <span class="meta-value"><?= $e(\strtoupper($currency)) ?></span>
        </div>
        <?php endif; ?>
        <?php if ($isCreditNote && $invoice->getReferenceInvoiceId() !== null): ?>
        <div class="meta-item">
            <span class="meta-label">Reference Invoice</span>
            <span class="meta-value"><?= $e($invoice->getReferenceInvoiceId()) ?></span>
        </div>
        <?php endif; ?>
    </div>

    <!-- Line Items -->
    <?php if (!empty($items)): ?>
    <div class="invoice-items">
        <table class="items-table">
            <thead>
                <tr>
                    <th>Description</th>
                    <th class="text-right">Quantity</th>
                    <th class="text-right">Unit Price</th>
                    <th class="text-right">Amount</th>
                </tr>
            </thead>
            <tbody>
                <?php foreach ($items as $item):
                    $type = $item['type'] ?? '';
                    $amount = (float) ($item['amount'] ?? 0);
                    $quantity = $item['quantity'] ?? null;
                    $unitPrice = $item['unitPrice'] ?? null;
                    $unit = $item['unit'] ?? '';
                    $resource = $item['resource'] ?? '';
                    $description = $item['description'] ?? '';
                    $rate = $item['rate'] ?? null;

                    $rowClass = '';
                    if ($type === 'discount') {
                        $rowClass = 'item-discount';
                    } elseif ($type === 'tax') {
                        $rowClass = 'item-tax';
                    }

                    $badgeClass = match ($type) {
                        'plan' => 'badge-plan',
                        'usage' => 'badge-usage',
                        'addon' => 'badge-addon',
                        'proration' => 'badge-proration',
                        'refund' => 'badge-refund',
                        default => '',
                    };
                ?>
                <tr class="<?= $e($rowClass) ?>">
                    <td>
                        <div class="item-description">
                            <?php if ($badgeClass !== ''): ?>
                                <span class="item-type-badge <?= $e($badgeClass) ?>"><?= $e(\ucfirst($type)) ?></span>
                            <?php endif; ?>
                            <?= $e($description) ?>
                        </div>
                        <?php if ($resource !== ''): ?>
                            <div class="item-resource"><?= $e($resource) ?></div>
                        <?php endif; ?>
                    </td>
                    <td class="text-right">
                        <?php if ($quantity !== null): ?>
                            <?= \number_format((float) $quantity, $quantity == (int) $quantity ? 0 : 2) ?><?= $unit !== '' ? ' ' . $e($unit) : '' ?>
                        <?php else: ?>
                            &mdash;
                        <?php endif; ?>
                    </td>
                    <td class="text-right">
                        <?php if ($unitPrice !== null): ?>
                            <?= $formatAmount((float) $unitPrice) ?>
                        <?php elseif ($rate !== null): ?>
                            <?= \number_format((float) $rate, 1) ?>%
                        <?php else: ?>
                            &mdash;
                        <?php endif; ?>
                    </td>
                    <td class="text-right">
                        <?= $amount < 0 ? '-' : '' ?><?= $formatAmount($amount) ?>
                    </td>
                </tr>
                <?php endforeach; ?>
            </tbody>
        </table>
    </div>
    <?php endif; ?>

    <!-- Totals -->
    <div class="invoice-totals">
        <table class="totals-table">
            <tr>
                <td class="total-label">Subtotal</td>
                <td class="total-value"><?= $formatAmount($invoice->getSubtotal()) ?></td>
            </tr>
            <?php if ($invoice->getDiscountTotal() != 0): ?>
            <tr class="total-discount">
                <td class="total-label">Discounts</td>
                <td class="total-value">-<?= $formatAmount($invoice->getDiscountTotal()) ?></td>
            </tr>
            <?php endif; ?>
            <?php if ($invoice->getTaxTotal() != 0): ?>
            <tr>
                <td class="total-label">Tax</td>
                <td class="total-value"><?= $formatAmount($invoice->getTaxTotal()) ?></td>
            </tr>
            <?php endif; ?>
            <tr class="total-row-grand">
                <td class="total-label">Total</td>
                <td class="total-value"><?= $formatAmount($invoice->getTotal()) ?></td>
            </tr>
            <?php if ($invoice->getWalletDeducted() > 0 || $invoice->getGatewayCharged() > 0): ?>
            <tr>
                <td colspan="2"><hr class="totals-divider"></td>
            </tr>
            <?php endif; ?>
            <?php if ($invoice->getWalletDeducted() > 0): ?>
            <tr class="total-payment">
                <td class="total-label">Wallet Deducted</td>
                <td class="total-value"><?= $formatAmount($invoice->getWalletDeducted()) ?></td>
            </tr>
            <?php endif; ?>
            <?php if ($invoice->getGatewayCharged() > 0): ?>
            <tr class="total-payment">
                <td class="total-label">Gateway Charged</td>
                <td class="total-value"><?= $formatAmount($invoice->getGatewayCharged()) ?></td>
            </tr>
            <?php endif; ?>
        </table>
    </div>

    <!-- Footer -->
    <div class="invoice-footer">
        <?php if (!empty($issuer['name'])): ?>
            <?= $e($issuer['name']) ?> &middot;
        <?php endif; ?>
        <?php if ($invoice->getNumber() !== ''): ?>
            <?= $e($isCreditNote ? 'Credit Note' : 'Invoice') ?> #<?= $e($invoice->getNumber()) ?>
        <?php endif; ?>
    </div>
</div>

</body>
</html>
